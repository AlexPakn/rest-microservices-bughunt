Date: Tue, 20 Oct 2026 15:13:51 +0300
Subject: [PATCH] fix(B01): post login body

---
 auth-service/main.py | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/auth-service/main.py b/auth-service/main.py
index 074a6fe..3ae41af 100644
--- a/auth-service/main.py
+++ b/auth-service/main.py
@@ -1,4 +1,5 @@
 from fastapi import FastAPI, Response
+from pydantic import BaseModel, ConfigDict, Field
 from fastapi.responses import JSONResponse
 
 app = FastAPI(title="AuthService")
@@ -8,8 +9,15 @@ USERS = {
 }
 
 
-@app.get("/login")
-async def login(email: str, password: str, response: Response):
+class LoginRequest(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    email: str = Field(min_length=1)
+    password: str = Field(min_length=1)
+
+
+@app.post("/login")
+async def login(payload: LoginRequest):
+    email, password = payload.email, payload.password
     user = USERS.get(email)
     if not user or user["password"] != password:
         return JSONResponse({"message": "invalid credentials"}, status_code=200)
