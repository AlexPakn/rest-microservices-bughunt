Date: Tue, 20 Oct 2026 15:14:48 +0300
Subject: [PATCH] fix(B08): enforce order authentication

---
 order-service/main.py | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/order-service/main.py b/order-service/main.py
index da223a0..184ab01 100644
--- a/order-service/main.py
+++ b/order-service/main.py
@@ -1,7 +1,7 @@
 import os
 
 import httpx
-from fastapi import FastAPI, Header
+from fastapi import FastAPI, Header, HTTPException
 from fastapi.responses import JSONResponse
 
 app = FastAPI(title="OrderService")
@@ -10,12 +10,19 @@ PRODUCT_URL = os.getenv("PRODUCT_URL", "http://localhost:8002")
 ORDERS: list[dict] = []
 
 
+async def authenticate(client, authorization):
+    if not authorization:
+        raise HTTPException(401, "Missing token", headers={"WWW-Authenticate": "Bearer"})
+    response = await client.get(f"{AUTH_URL}/whoami", headers={"Authorization": authorization})
+    if response.status_code in (401, 403):
+        raise HTTPException(response.status_code, "Authorization rejected")
+    return response.json()
+
+
 @app.post("/orders")
 async def create_order(payload: dict, authorization: str | None = Header(default=None)):
     async with httpx.AsyncClient() as client:
-        _ = await client.get(
-            f"{AUTH_URL}/whoami", headers={"Authorization": authorization or ""}
-        )
+        identity = await authenticate(client, authorization)
     order = {
         "order_id": len(ORDERS) + 1,
         "product_id": payload.get("productId"),
